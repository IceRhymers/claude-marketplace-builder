{
  "mcpServers": {
    "slack-mcp": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "uc-mcp-proxy",
        "--url", "${SLACK_MCP_URL:-https://slack-mcp-server-468531251905809.aws.databricksapps.com/mcp/}",
        "--auth-type", "databricks-cli"
      ]
    },
    "genie-mcp": {
      "type": "http",
      "url": "${DATABRICKS_HOST}/api/2.0/mcp/genie/${GENIE_SPACE_ID:-01f11733962d175c9ad16dc83db6e9af}",
      "headers": {
        "Authorization": "Bearer ${DATABRICKS_TOKEN}"
      }
    }
  }
}

{
  "name": "icerhymers-budget-checker",
  "description": "Blocks prompts when a user exceeds their Databricks AI Gateway token budget.",
  "version": "1.0.2",
  "author": {
    "name": "AI engineering"
  },
  "skills": "./skills/",
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/check-budget.sh --enforce",
            "timeout": 10000
          }
        ]
      }
    ]
  }
}

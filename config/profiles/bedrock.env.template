# ==============================================================================
# AWS Bedrock — Inference Profile
#
# Routes Claude Code through AWS Bedrock.
# Requires AWS credentials via environment variables, CLI profiles, or
# instance roles.
#
# Docs: https://code.claude.com/docs/en/amazon-bedrock
# ==============================================================================

# Required: tells Claude Code to use the Bedrock backend
CLAUDE_CODE_USE_BEDROCK=1

# AWS region where Bedrock is enabled (e.g., us-east-1, us-west-2)
AWS_REGION={{AWS_REGION}}

# Optional: explicit credentials (leave blank to use AWS CLI profile / instance role)
# AWS_ACCESS_KEY_ID={{AWS_ACCESS_KEY_ID}}
# AWS_SECRET_ACCESS_KEY={{AWS_SECRET_ACCESS_KEY}}
# AWS_PROFILE={{AWS_PROFILE}}

# Pin Bedrock model versions for stability
# ANTHROPIC_DEFAULT_OPUS_MODEL=us.anthropic.claude-opus-4-6-v1
# ANTHROPIC_DEFAULT_SONNET_MODEL=us.anthropic.claude-sonnet-4-5-v1
# ANTHROPIC_DEFAULT_HAIKU_MODEL=us.anthropic.claude-haiku-4-5-v1

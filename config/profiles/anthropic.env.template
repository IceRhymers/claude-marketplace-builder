# ==============================================================================
# Anthropic Direct — Inference Profile
#
# Uses the Anthropic API directly. No ANTHROPIC_BASE_URL needed — Claude Code
# uses the default Anthropic endpoint.
#
# How to get your API key:
#   1. Go to https://console.anthropic.com/
#   2. Create or copy an API key
#
# Security note: You can set ANTHROPIC_API_KEY in your shell profile
# (~/.bashrc, ~/.zshrc) instead of storing it in this file.
# ==============================================================================

ANTHROPIC_API_KEY={{ANTHROPIC_API_KEY}}

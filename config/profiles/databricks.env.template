# ==============================================================================
# Databricks AI Gateway — Inference Profile (Default)
#
# Routes Claude Code through Databricks Model Serving using the native
# Anthropic Messages API.
#
# Only the workspace URL varies — the path /serving-endpoints/anthropic is
# fixed. Model selection happens in the request payload, not the URL.
#
# Docs: https://docs.databricks.com/aws/en/machine-learning/model-serving/query-anthropic-messages
#
# Security note: You can set ANTHROPIC_AUTH_TOKEN in your shell profile
# (~/.bashrc, ~/.zshrc) instead of storing it in this file.
# ==============================================================================

ANTHROPIC_BASE_URL={{DATABRICKS_WORKSPACE_URL}}/serving-endpoints/anthropic

# Databricks PAT or OAuth token (sent as Bearer token in Authorization header)
ANTHROPIC_AUTH_TOKEN={{DATABRICKS_TOKEN}}

# Pin Databricks-hosted Claude models for enterprise stability
# See: https://code.claude.com/docs/en/model-config
ANTHROPIC_DEFAULT_OPUS_MODEL=databricks-claude-opus-4-6
ANTHROPIC_DEFAULT_SONNET_MODEL=databricks-claude-sonnet-4-5
ANTHROPIC_DEFAULT_HAIKU_MODEL=databricks-claude-haiku-4-5

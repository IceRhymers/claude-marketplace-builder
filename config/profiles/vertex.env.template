# ==============================================================================
# Google Vertex AI — Inference Profile
#
# Routes Claude Code through Google Cloud Vertex AI.
# Requires GCP credentials and a project with Vertex AI + Claude models enabled.
#
# Docs: https://code.claude.com/docs/en/google-vertex-ai
# ==============================================================================

# Required: tells Claude Code to use the Vertex AI backend
CLAUDE_CODE_USE_VERTEX=1

# GCP project ID
CLOUD_ML_PROJECT_ID={{GCP_PROJECT_ID}}

# GCP region where Vertex AI is enabled (e.g., us-east5, europe-west1)
CLOUD_ML_REGION={{GCP_REGION}}

# Auth: use `gcloud auth application-default login` or set:
# GOOGLE_APPLICATION_CREDENTIALS={{PATH_TO_SA_KEY}}
